# =============================================================================
# Beacon In-Home Care — environment variables (names only; never commit secrets)
# =============================================================================

# Public site URL used for canonical links, sitemap, Open Graph, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://beaconihc.com

# Contact details (defaults match published beaconihc.com contact information)
NEXT_PUBLIC_PHONE=5034771571
NEXT_PUBLIC_PHONE_DISPLAY=(503) 477-1571
NEXT_PUBLIC_PHONE_SECONDARY=9712359248
NEXT_PUBLIC_PHONE_SECONDARY_DISPLAY=(971) 235-9248
NEXT_PUBLIC_EMAIL=info@beaconihc.com
NEXT_PUBLIC_ADDRESS=9844 SE Kela Ct, Happy Valley, OR 97086
NEXT_PUBLIC_SERVICE_AREA=Serving individuals and families in Oregon
NEXT_PUBLIC_HOURS=

# Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# -----------------------------------------------------------------------------
# Contact form delivery (server-only — never expose to the client)
# First configured transport wins: webhook → Resend → deferred accept
# -----------------------------------------------------------------------------

# Option A: generic webhook / Zapier / Make / custom endpoint
CONTACT_WEBHOOK_URL=

# Option B: Resend email delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@beaconihc.com
CONTACT_FROM_EMAIL=
